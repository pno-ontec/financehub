NODE_ENV=development
PORT=3000

# Segurança (gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=SUBSTITUA_POR_STRING_ALEATORIA_128_CHARS
SECRET_KEY=SUBSTITUA_POR_STRING_ALEATORIA_64_CHARS
KEY_SALT=SUBSTITUA_POR_STRING_ALEATORIA_64_CHARS

# CORS (em produção, coloque o domínio real)
ALLOWED_ORIGINS=http://localhost:3000

# E-mail do administrador master (terá acesso gratuito e ilimitado)
ADMIN_EMAIL=admin@financehub.com.br

# PIX (configure com seus dados reais para produção)
PIX_KEY=00000000000
PIX_NAME=FinanceHub
PIX_CITY=SAO PAULO
