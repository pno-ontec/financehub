# FinanceHub — Variáveis de Produção
# Copie para .env e preencha os valores reais

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
PGDATABASE=financehub
PGUSER=financehub
PGPASSWORD=TROQUE_POR_SENHA_FORTE_AQUI

# ── JWT / Segurança (gere com: openssl rand -hex 64) ───────────────────────────
JWT_SECRET=TROQUE_POR_64_BYTES_HEX
SECRET_KEY=TROQUE_POR_32_BYTES_HEX
KEY_SALT=TROQUE_POR_32_BYTES_HEX

# ── Aplicação ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://SEU_DOMINIO.COM.BR

# ── Admin master ───────────────────────────────────────────────────────────────
ADMIN_EMAIL=paulinho.n.oliveira@gmail.com

# ── PIX ────────────────────────────────────────────────────────────────────────
PIX_KEY=SEU_CPF_OU_EMAIL_PIX
PIX_NAME=SEU NOME AQUI
PIX_CITY=SAO PAULO

# ── Anthropic (foto de comprovante - opcional) ─────────────────────────────────
ANTHROPIC_API_KEY=
